# Server-side only (NOT NEXT_PUBLIC_*): read only in src/composition.
# The BFF aggregate this site consumes — never point at cv-domain-service directly.
# BFF_URL is a bare origin: no trailing slash, no /bff/api/v1 path (the app
# appends it). Required when VERCEL_ENV=production (the build fails without it).
BFF_URL=http://localhost:3000
PERSON_ID=1
